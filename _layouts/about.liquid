---
layout: default
---
{% comment %}
  Li-Cheng: custom home page (overrides al_folio_core's about layout).
  Content comes from _pages/about.md (front matter + body) and _data/experience.yml.
{% endcomment %}
<div class="post home">
  <!-- Hero -->
  <section class="home-hero">
    <div class="home-hero-text">
      <p class="eyebrow">Hello, I am</p>
      <h1 class="home-name">
        <span class="highlight-mark">{{ site.first_name }}</span><br>
        {{ site.last_name }}
        {% if page.chinese_name %}<span class="home-name-cn">{{ page.chinese_name }}</span>{% endif %}
      </h1>
      {% if page.subtitle %}<p class="home-lead">{{ page.subtitle }}</p>{% endif %}
      {% if page.interests %}
        <div class="chip-row">
          {% for item in page.interests %}<span class="chip">{{ item }}</span>{% endfor %}
        </div>
      {% endif %}
      {% if page.links %}
        <div class="btn-row home-links">
          {% for link in page.links %}
            {% if link.url contains '://' or link.url contains 'mailto:' %}
              {% assign href = link.url %}
            {% else %}
              {% assign href = link.url | relative_url %}
            {% endif %}
            <a
              class="{% if forloop.first %}btn-solid{% else %}btn-outline{% endif %}"
              href="{{ href }}"
              {% if href contains '://' %}
                target="_blank" rel="noopener"
              {% endif %}
            >
              {% if link.icon %}<i class="{{ link.icon }}" aria-hidden="true"></i>{% endif %}
              {{ link.label }}
            </a>
          {% endfor %}
        </div>
      {% endif %}
    </div>
    <div class="home-photo offset-frame">
      {% if page.profile_image %}
        <img
          src="{{ page.profile_image | prepend: '/assets/img/' | relative_url }}"
          alt="Photo of {{ site.first_name }} {{ site.last_name }}"
          loading="eager"
        >
      {% else %}
        <div class="frame-inner home-photo-empty" aria-hidden="true">LT</div>
      {% endif %}
    </div>
  </section>

  <!-- 01 About -->
  <section class="home-section">
    <div class="home-section-head">
      <span class="section-label">01</span>
      <h2>About</h2>
    </div>
    <div class="home-section-body home-bio">{{ content }}</div>
  </section>

  <!-- 02 Experience & Awards -->
  {% if site.data.experience %}
    <section class="home-section">
      <div class="home-section-head">
        <span class="section-label">02</span>
        <h2>Experience<br>&amp; Awards</h2>
      </div>
      <div class="home-section-body">
        <ul class="exp-list">
          {% for e in site.data.experience %}
            <li class="exp-item">
              <span class="exp-kind">{{ e.kind }}</span>
              <div class="exp-main">
                <span class="exp-title">{{ e.title }}</span>
                {% if e.detail %}<span class="exp-detail">{{ e.detail }}</span>{% endif %}
              </div>
              <span class="exp-date">{{ e.date }}</span>
            </li>
          {% endfor %}
        </ul>
      </div>
    </section>
  {% endif %}

  <!-- 03 Selected Projects -->
  {% assign picks = site.projects | where: 'selected', true | sort: 'date' | reverse %}
  {% if picks.size > 0 %}
    <section class="home-picks">
      <div class="home-picks-head">
        <div>
          <span class="section-label">03</span>
          <h2>Selected Projects</h2>
        </div>
        <a class="home-more" href="{{ '/projects/' | relative_url }}">All projects →</a>
      </div>
      <div class="pick-grid">
        {% assign limit = page.selected_projects_limit | default: 3 %}
        {% for p in picks limit: limit %}
          <a class="pick-card" href="{% if p.redirect %}{{ p.redirect }}{% else %}{{ '/projects/' | relative_url }}#{{ p.slug }}{% endif %}">
            {% if p.img %}
              <img class="pick-thumb" src="{{ p.img | relative_url }}" alt="" loading="lazy">
            {% else %}
              <div class="pick-thumb pick-thumb-empty" aria-hidden="true">{{ p.title }}</div>
            {% endif %}
            <div class="pick-body">
              {% if p.tags %}<span class="chip">{{ p.tags | first }} · {{ p.date | date: '%Y.%m' }}</span>{% endif %}
              <span class="pick-title">{{ p.title }}</span>
              {% if p.description %}<span class="pick-desc">{{ p.description }}</span>{% endif %}
            </div>
          </a>
        {% endfor %}
      </div>
    </section>
  {% endif %}
</div>
